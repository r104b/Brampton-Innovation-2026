# Master backend only. Never copy secrets into a client repository.
INGEST_TOKEN=replace-locally
SUPABASE_URL=https://YOUR_TEST_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-locally
GEMINI_API_KEY=replace-locally
GEMINI_MODEL=select-a-supported-structured-output-model
CLIENT_REGISTRY_PATH=config/clients.json
REGISTRY_BACKEND=supabase
MASTER_REPOSITORY=YOUR_TEAM/sentra-master
# JSON grants: [{"token":"local-secret","projects":["maple-grove-demo"],"reviewer":"operator-id"}]
# Keep actual credentials in process/hosting secrets, never in committed files.
PROJECT_ACCESS_JSON=[]
CLIENT_SYNC_ENABLED=false
CONTEXT_GITHUB_TOKEN=replace-locally
# Set to the exact master git commit used to run the backend.
MASTER_REVISION=replace-with-master-commit-sha
